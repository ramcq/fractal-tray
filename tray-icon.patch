diff --git a/src/tray/linux.rs b/src/tray/linux.rs
new file mode 100644
index 0000000..ae16a7f
--- /dev/null
+++ b/src/tray/linux.rs
@@ -0,0 +1,381 @@
+//! Tray icon backend using the `StatusNotifierItem` specification.
+//!
+//! It is implemented natively by KDE Plasma, and on GNOME Shell by the
+//! AppIndicator extension.
+
+use futures_channel::mpsc::{UnboundedSender, unbounded};
+use futures_util::StreamExt;
+use gettextrs::gettext;
+use gtk::{gdk, gio, glib, glib::clone, prelude::*, subclass::prelude::*};
+use ksni::{
+    Category, Icon, Status, ToolTip, TrayMethods,
+    menu::{MenuItem, StandardItem},
+};
+use tracing::{debug, error, warn};
+
+use super::TrayIconExt;
+use crate::{
+    APP_NAME, Application, config, ngettext_f,
+    session::{Room, Session},
+    spawn, spawn_tokio,
+    utils::ExpressionListModel,
+};
+
+/// The path of the application icon in the resources.
+///
+/// The name of the file does not depend on the profile that was built.
+const ICON_RESOURCE_PATH: &str = "/org/gnome/Fractal/icons/scalable/apps/org.gnome.Fractal.svg";
+
+/// A request made by the user through the tray icon.
+#[derive(Debug, Clone, Copy)]
+enum TrayRequest {
+    /// Show the window, or hide it if it is already visible.
+    ToggleWindow,
+    /// Show the window.
+    ShowWindow,
+    /// Quit the application.
+    Quit,
+}
+
+/// Process the given request from the tray icon.
+fn process_request(request: TrayRequest) {
+    let app = Application::default();
+
+    match request {
+        TrayRequest::ToggleWindow => app.toggle_main_window(),
+        TrayRequest::ShowWindow => {
+            app.present_main_window();
+        }
+        TrayRequest::Quit => app.quit_application(),
+    }
+}
+
+/// Load the application icon as an ARGB32 image.
+///
+/// This is only used as a fallback for trays that cannot find our icon by
+/// name, which should not happen when the icon is installed on the system.
+fn load_icon() -> Option<Icon> {
+    let bytes = gio::resources_lookup_data(ICON_RESOURCE_PATH, gio::ResourceLookupFlags::NONE)
+        .inspect_err(|error| warn!("Could not load the tray icon from the resources: {error}"))
+        .ok()?;
+    let texture = gdk::Texture::from_bytes(&bytes)
+        .inspect_err(|error| warn!("Could not decode the tray icon: {error}"))
+        .ok()?;
+
+    let mut downloader = gdk::TextureDownloader::new(&texture);
+    // We need straight, i.e. not premultiplied, RGBA to convert to ARGB32.
+    downloader.set_format(gdk::MemoryFormat::R8g8b8a8);
+    let (pixels, stride) = downloader.download_bytes();
+
+    let width = texture.width();
+    let height = texture.height();
+    let mut data = Vec::with_capacity(width as usize * height as usize * 4);
+
+    for row in 0..height as usize {
+        for column in 0..width as usize {
+            let offset = row * stride + column * 4;
+
+            let Some(&[red, green, blue, alpha]) = pixels.get(offset..offset + 4) else {
+                error!("Tray icon pixel data is shorter than the texture");
+                return None;
+            };
+
+            // ARGB32 in network, i.e. big-endian, byte order.
+            data.extend_from_slice(&[alpha, red, green, blue]);
+        }
+    }
+
+    Some(Icon {
+        width,
+        height,
+        data,
+    })
+}
+
+/// The `StatusNotifierItem` representing the application in the tray.
+struct TrayItem {
+    /// The channel to send the requests of the user to the main thread.
+    sender: UnboundedSender<TrayRequest>,
+    /// The application icon, if it could be loaded.
+    icon: Option<Icon>,
+    /// The number of notifications pending across all the sessions.
+    notification_count: u64,
+}
+
+impl TrayItem {
+    /// Send the given request to the main thread.
+    fn request(&self, request: TrayRequest) {
+        if self.sender.unbounded_send(request).is_err() {
+            warn!("Could not send tray request: the application is not listening anymore");
+        }
+    }
+}
+
+impl ksni::Tray for TrayItem {
+    fn id(&self) -> String {
+        config::APP_ID.to_owned()
+    }
+
+    fn title(&self) -> String {
+        APP_NAME.to_owned()
+    }
+
+    fn category(&self) -> Category {
+        Category::Communications
+    }
+
+    fn status(&self) -> Status {
+        if self.notification_count > 0 {
+            Status::NeedsAttention
+        } else {
+            Status::Active
+        }
+    }
+
+    fn icon_name(&self) -> String {
+        config::APP_ID.to_owned()
+    }
+
+    fn attention_icon_name(&self) -> String {
+        config::APP_ID.to_owned()
+    }
+
+    fn icon_pixmap(&self) -> Vec<Icon> {
+        self.icon.clone().into_iter().collect()
+    }
+
+    fn attention_icon_pixmap(&self) -> Vec<Icon> {
+        self.icon_pixmap()
+    }
+
+    fn tool_tip(&self) -> ToolTip {
+        let description = if self.notification_count > 0 {
+            ngettext_f(
+                // Translators: Do NOT translate the content between '{' and '}', this is a
+                // variable name.
+                "{count} unread notification",
+                "{count} unread notifications",
+                self.notification_count.try_into().unwrap_or(u32::MAX),
+                &[("count", &self.notification_count.to_string())],
+            )
+        } else {
+            gettext("No unread notifications")
+        };
+
+        ToolTip {
+            icon_name: config::APP_ID.to_owned(),
+            icon_pixmap: self.icon_pixmap(),
+            title: APP_NAME.to_owned(),
+            description,
+        }
+    }
+
+    fn menu(&self) -> Vec<MenuItem<Self>> {
+        vec![
+            StandardItem {
+                label: gettext("_Show Fractal"),
+                activate: Box::new(|item: &mut Self| item.request(TrayRequest::ShowWindow)),
+                ..Default::default()
+            }
+            .into(),
+            MenuItem::Separator,
+            StandardItem {
+                label: gettext("_Quit"),
+                activate: Box::new(|item: &mut Self| item.request(TrayRequest::Quit)),
+                ..Default::default()
+            }
+            .into(),
+        ]
+    }
+
+    fn activate(&mut self, _x: i32, _y: i32) {
+        self.request(TrayRequest::ToggleWindow);
+    }
+}
+
+mod imp {
+    use std::cell::{Cell, RefCell};
+
+    use super::*;
+
+    #[derive(Default)]
+    pub struct LinuxTrayIcon {
+        /// The handle to the running tray service.
+        pub(super) handle: RefCell<Option<ksni::Handle<TrayItem>>>,
+        /// The models watching the notification count of the rooms of every
+        /// session.
+        room_models: RefCell<Vec<ExpressionListModel>>,
+        /// The notification count that was last sent to the tray.
+        notification_count: Cell<u64>,
+    }
+
+    #[glib::object_subclass]
+    impl ObjectSubclass for LinuxTrayIcon {
+        const NAME: &'static str = "TrayIcon";
+        type Type = super::LinuxTrayIcon;
+    }
+
+    impl ObjectImpl for LinuxTrayIcon {
+        fn constructed(&self) {
+            self.parent_constructed();
+
+            self.start_service();
+            self.watch_sessions();
+        }
+
+        fn dispose(&self) {
+            if let Some(handle) = self.handle.take() {
+                let _ = handle.shutdown();
+            }
+        }
+    }
+
+    impl LinuxTrayIcon {
+        /// Start the tray service.
+        fn start_service(&self) {
+            let (sender, mut receiver) = unbounded();
+            let item = TrayItem {
+                sender,
+                icon: load_icon(),
+                notification_count: 0,
+            };
+
+            spawn!(clone!(
+                #[weak(rename_to = imp)]
+                self,
+                async move {
+                    // A sandboxed application cannot own the well-known D-Bus name that
+                    // the specification asks for, it must register with its unique name.
+                    let is_sandboxed = ashpd::is_sandboxed();
+
+                    let result =
+                        spawn_tokio!(
+                            async move { item.disable_dbus_name(is_sandboxed).spawn().await }
+                        )
+                        .await
+                        .expect("task was not aborted");
+
+                    match result {
+                        Ok(handle) => {
+                            debug!("Registered the tray icon");
+                            imp.handle.replace(Some(handle));
+                            // The notification count might have been computed while the
+                            // service was starting.
+                            imp.send_notification_count();
+                        }
+                        Err(error) => {
+                            warn!("Could not register the tray icon: {error}");
+                        }
+                    }
+                }
+            ));
+
+            // The requests of the user are processed on the main thread.
+            spawn!(async move {
+                while let Some(request) = receiver.next().await {
+                    process_request(request);
+                }
+
+                debug!("The tray icon service stopped");
+            });
+        }
+
+        /// Watch the sessions to keep track of the number of pending
+        /// notifications.
+        fn watch_sessions(&self) {
+            let app = Application::default();
+            app.session_list().connect_items_changed(clone!(
+                #[weak(rename_to = imp)]
+                self,
+                move |_, _, _, _| {
+                    imp.watch_rooms();
+                }
+            ));
+
+            self.watch_rooms();
+        }
+
+        /// Watch the rooms of every session to keep track of the number of
+        /// pending notifications.
+        fn watch_rooms(&self) {
+            let mut room_models = Vec::new();
+
+            let app = Application::default();
+
+            for session in app.session_list().iter::<glib::Object>() {
+                let Some(session) = session.ok().and_downcast::<Session>() else {
+                    continue;
+                };
+
+                let room_model = ExpressionListModel::new();
+                room_model
+                    .set_expressions(vec![Room::this_expression("notification-count").upcast()]);
+                room_model.connect_items_changed(clone!(
+                    #[weak(rename_to = imp)]
+                    self,
+                    move |_, _, _, _| {
+                        imp.update_notification_count();
+                    }
+                ));
+                room_model.set_model(Some(session.room_list()));
+
+                room_models.push(room_model);
+            }
+
+            self.room_models.replace(room_models);
+            self.update_notification_count();
+        }
+
+        /// Update the number of pending notifications across all the sessions.
+        fn update_notification_count(&self) {
+            let room_models = self.room_models.borrow();
+            let notification_count = room_models
+                .iter()
+                .flat_map(|room_model| room_model.iter::<glib::Object>())
+                .filter_map(|room| room.ok().and_downcast::<Room>())
+                .map(|room| room.notification_count())
+                .sum();
+            drop(room_models);
+
+            if self.notification_count.get() == notification_count {
+                return;
+            }
+
+            self.notification_count.set(notification_count);
+            self.send_notification_count();
+        }
+
+        /// Send the current number of pending notifications to the tray.
+        pub(super) fn send_notification_count(&self) {
+            let Some(handle) = self.handle.borrow().clone() else {
+                return;
+            };
+
+            let notification_count = self.notification_count.get();
+            spawn_tokio!(async move {
+                let _ = handle
+                    .update(|item: &mut TrayItem| item.notification_count = notification_count)
+                    .await;
+            });
+        }
+    }
+}
+
+glib::wrapper! {
+    /// A tray icon using the `StatusNotifierItem` specification.
+    pub struct LinuxTrayIcon(ObjectSubclass<imp::LinuxTrayIcon>);
+}
+
+impl TrayIconExt for LinuxTrayIcon {
+    fn new() -> Self {
+        glib::Object::new()
+    }
+
+    fn is_registered(&self) -> bool {
+        self.imp()
+            .handle
+            .borrow()
+            .as_ref()
+            .is_some_and(|handle| !handle.is_closed())
+    }
+}
