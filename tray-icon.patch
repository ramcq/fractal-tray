+++ b/src/tray/mod.rs
@@ -0,0 +1,48 @@
+//! System tray icon API.
+//!
+//! A tray icon allows the application to keep running with its window hidden,
+//! and gives the user a way to bring the window back.
+
+#[cfg(target_os = "linux")]
+mod linux;
+
+cfg_if::cfg_if! {
+    if #[cfg(target_os = "linux")] {
+        /// The tray icon API.
+        pub(crate) type TrayIcon = linux::LinuxTrayIcon;
+    } else {
+        /// The tray icon API.
+        pub(crate) type TrayIcon = unimplemented::UnimplementedTrayIcon;
+    }
+}
+
+/// Trait implemented by tray icon backends.
+pub(crate) trait TrayIconExt {
+    /// Construct a tray icon and start registering it with the system.
+    fn new() -> Self;
+
+    /// Whether the tray icon is registered with the system.
+    ///
+    /// While it is not, the window must not be hidden, or the user would have
+    /// no way to bring it back.
+    fn is_registered(&self) -> bool;
+}
+
+/// The fallback tray icon API, used on platforms where it is unimplemented.
+#[cfg(not(target_os = "linux"))]
+mod unimplemented {
+    use super::*;
+
+    #[derive(Debug)]
+    pub(crate) struct UnimplementedTrayIcon;
+
+    impl TrayIconExt for UnimplementedTrayIcon {
+        fn new() -> Self {
